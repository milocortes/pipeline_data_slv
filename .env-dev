RUSTFS_ACCESS_KEY="rustfsadmin"
RUSTFS_SECRET_KEY="rustfsadmin"
RUSTFS_CONSOLE_ENABLE=true 
RUSTFS_SERVER_DOMAINS="example.com"

AIRFLOW_UID=1000
AIRFLOW_GID=0

_PIP_ADDITIONAL_REQUIREMENTS="apache-airflow-providers-docker"

AIRFLOW_IMAGE_NAME=apache/airflow:3.1.2

# General environment variables
start_date="2012-01-01"
LSIB="FAO/GAUL/2015/level0"
BUCKET_NAME="pronostico"
BUCKET_RESPALDO="respaldo"
#BUCKET_NAME="pronostico-pib-geoespacial-slv"
service_account_gee="geoespacial@pib-geoespacial.iam.gserviceaccount.com"
gee_project="pib-geoespacial"

# Storage environment variables
RUSTFS_DNS="rustfs"
RUSTFS_PORT="9000"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="rustfsadmin"
AWS_SECRET_ACCESS_KEY="rustfsadmin"
#AWS_REGION=$AWS_REGION
#AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
#AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY
allow_http='true' 
S3_AWS_STORAGE='False'

# Apache Airflow environment variables
AIRFLOW_APISERVER_DOMAIN="http://airflow-apiserver"
AIRFLOW_APISERVER_PORT="8080"
_AIRFLOW_WWW_USER_PASSWORD="airflow"
_AIRFLOW_WWW_USER_USERNAME="airflow"

# Google Sheets environment variables
#GS_SPREADSHEET="insumos-tablero-pib"
GS_SPREADSHEET="test_pronostico"

# API Keys environment variables
GS_API_KEY_FILE="pronosticos-493700-56f57502ffb3.json" 
GEE_API_KEY_FILE="pib-geoespacial-3ba5fc82e62c.json" 